package ui

// Login is dross's own sign-in screen. An unauthenticated browser lands here
// instead of being bounced straight to the identity provider, so the first
// thing a user sees is dross rather than a Cloudflare interstitial. The button
// starts the same OIDC flow the redirect used to.
//
// There is one button, because there is one thing to do: signing in *is* the
// request. A Google account dross has never seen registers as pending and waits
// for an admin. A second button labelled "request access" started the identical
// flow, which is a choice a stranger has to think about for no gain - the copy
// underneath says what happens instead.
//
// This screen is the fallback for a deployment where Kratos is not running the
// login. With Kratos, its own flow page is what a browser sees.
templ Login(loginURL string) {
	@cardPage("Sign in") {
		@mark()
		<h1>Dross</h1>
		<p>Sign in to continue.</p>
		<a class="btn" href={ templ.SafeURL(loginURL) }>
			<svg width="18" height="18" viewBox="0 0 48 48" aria-hidden="true">
				<path fill="#EA4335" d="M24 9.5c3.5 0 6.6 1.2 9.1 3.6l6.8-6.8C35.9 2.4 30.4 0 24 0 14.6 0 6.5 5.4 2.6 13.2l7.9 6.2C12.4 13.7 17.7 9.5 24 9.5z"></path>
				<path fill="#4285F4" d="M46.1 24.6c0-1.6-.1-2.8-.4-4H24v7.5h12.7c-.3 2.1-1.6 5.2-4.7 7.3l7.3 5.6c4.3-4 6.8-9.8 6.8-16.4z"></path>
				<path fill="#FBBC05" d="M10.5 28.6c-.5-1.5-.8-3-.8-4.6s.3-3.2.8-4.6l-7.9-6.2C1 16.3 0 20 0 24s1 7.7 2.6 10.8l7.9-6.2z"></path>
				<path fill="#34A853" d="M24 48c6.5 0 11.9-2.1 15.9-5.8l-7.3-5.6c-2 1.4-4.6 2.3-8.6 2.3-6.3 0-11.6-4.2-13.5-9.9l-7.9 6.2C6.5 42.6 14.6 48 24 48z"></path>
			</svg>
			Continue with Google
		</a>
		<div class="hairline"></div>
		<p class="foot">New here? Signing in is how you ask: pick a Google account and an admin approves it.</p>
	}
}

// Pending is what an authenticated account that has not been approved sees on
// every route. Google has said who they are; dross has not yet agreed they may
// be here. A dead end by design, with one way out that is not the back button:
// sign out, so a household machine can be handed to someone else.
templ Pending(email string) {
	@cardPage("Access pending") {
		@mark()
		<h1>Request received</h1>
		<p>Your account is waiting to be approved. You will get an email when it is.</p>
		<span class="who">{ email }</span>
		<div class="hairline"></div>
		<p class="foot">Not you? <a class="link" href="/auth/logout">Sign out</a>.</p>
	}
}

// Setup is the first-run page: this server has nobody who can approve anyone,
// so the person looking at it is offered the job. Shown to any authenticated
// identity, because the alternative on a fresh install is a waiting room with
// no staff — everyone pending, and whoever could fix it refused with the rest.
//
// It disappears the moment the role is taken. The claim itself is decided on
// the server under one lock, so two people racing this page cannot both win.
templ Setup(email string) {
	@cardPage("Set up") {
		@mark()
		<h1>No administrator yet</h1>
		<p>Nobody can approve accounts on this server, including yours. Claim it and you become the first admin.</p>
		<span class="who">{ email }</span>
		<form method="post" action="/setup/claim">
			<button class="btn" type="submit">Make me the administrator</button>
		</form>
		<div class="hairline"></div>
		<p class="foot">Only offered while there is no admin. Whoever claims it first gets it, and everyone else waits to be approved.</p>
	}
}

// Flow draws a Kratos self-service flow: login, registration, whatever it is
// configured to ask for.
//
// Kratos describes its forms as data - where to post, which fields to include,
// what to call the buttons - and this renders that rather than hardcoding
// today's answer. Turn on a second method in the config and it appears here
// without a code change; turn one off and it stops being offered, which is the
// property that matters for a login screen.
templ Flow(v FlowView) {
	@cardPage(v.Title) {
		@mark()
		<h1>{ v.Heading }</h1>
		if v.Lead != "" {
			<p>{ v.Lead }</p>
		}
		for _, m := range v.Messages {
			<div class={ "flash", m.Kind }>{ m.Text }</div>
		}
		if v.Action != "" {
			<form method={ v.Method } action={ templ.SafeURL(v.Action) }>
				for _, h := range v.Hidden {
					<input type="hidden" name={ h.Name } value={ h.Value }/>
				}
				for _, b := range v.Buttons {
					<button class={ "btn", b.Style } type="submit" name={ b.Name } value={ b.Value }>{ b.Label }</button>
				}
			</form>
		}
		<div class="hairline"></div>
		<p class="foot">{ v.Foot }</p>
	}
}
